# Copie para .env e preencha. NUNCA envie o arquivo .env para o GitHub.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A API roda no servidor (nunca no navegador). Com o login ativado no site, as tabelas
# de prestadores só podem ser lidas por usuários logados; por isso use aqui a chave SECRET
# (sb_secret_...). NUNCA coloque essa chave no frontend nem envie este arquivo ao GitHub.
SUPABASE_KEY=

# Só altere se o nome da tabela/colunas mudar no Cold-Sense
FREEZER_AI_TABELA=temperaturas
FREEZER_AI_COLUNA_TEMPERATURA=temperatura
FREEZER_AI_COLUNA_DATA=coletado_em
FREEZER_AI_COLUNA_DISPOSITIVO=freezer_id
FREEZER_AI_TABELA_FREEZERS=freezers
# Fuso usado para separar os dias no histórico
FREEZER_AI_FUSO=America/Fortaleza

# API (usada pelo site)
# Endereços do site que podem chamar a API, separados por vírgula
FREEZER_AI_CORS_ORIGINS=http://localhost:5173
# Descomente para testar o site com dados simulados (sem banco)
# FREEZER_AI_FONTE=simulacao

# Faixa recomendada de cada freezer (tabela "freezers")
FREEZER_AI_COLUNA_TEMP_MIN=temperatura_min
FREEZER_AI_COLUNA_TEMP_MAX=temperatura_max
# Quantos °C acima da máxima recomendada vira "crítico"
FREEZER_AI_MARGEM_CRITICA=3

# ---------------- Alertas automáticos ----------------
# 1 = vigia ligado (padrão) | 0 = desligado
FREEZER_AI_MONITOR=1
# Intervalo entre verificações (segundos)
FREEZER_AI_MONITOR_INTERVALO_S=60
# Endereço do site que aparece no e-mail
FREEZER_AI_URL_SITE=http://localhost:5173/freezer-ai

# E-mail (Gmail): conta remetente + "senha de app" de 16 letras
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Quem recebe: os prestadores ATIVOS ligados ao freezer (tela Prestadores)
# + estes endereços em cópia (separados por vírgula), opcional
FREEZER_AI_EMAIL_COPIA=
# Enviar e-mail a partir de: critico (padrão) ou atencao
FREEZER_AI_EMAIL_NIVEL=critico
# Lembrete enquanto ninguém marcar "Ciente" (minutos)
FREEZER_AI_EMAIL_LEMBRETE_MIN=60
