# Copie para firmware/.env e preencha. NUNCA envie o .env para o GitHub.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=

# Porta da ESP32: Windows = COM3, COM4... (veja no Gerenciador de Dispositivos)
# Linux/Mac = /dev/ttyUSB0 ou /dev/ttyACM0
PORTA_SERIAL=COM3
VELOCIDADE_SERIAL=115200
# Segundos entre gravações no Supabase (a Freezer AI espera ~10)
INTERVALO_ENVIO=10
# id do freezer deste ESP32 na tabela "freezers" do Supabase (ex.: 1)
FREEZER_ID=
# Só para aviso no console
LIMITE_TEMPERATURA=30
